generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  OPERADOR
}

enum ApplicantType {
  SINGULAR
  COLETIVA
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  FORM_STARTED
  FORM_COMPLETED
  AWAITING_PAYMENT
  PAYMENT_CONFIRMED
  AWAITING_REVIEW
  DOCUMENT_GENERATED
  DELIVERED
  REJECTED_NO_TEMPLATE
}

enum SelectionOutcome {
  SELECTED
  NO_TEMPLATE
  AMBIGUOUS
  LEGITIMACY_ISSUE
  MANUAL_OVERRIDE
}

enum PaymentMethod {
  MBWAY
  CARD
  MULTIBANCO
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
  REFUNDED
}

enum FileKind {
  NOTIFICATION
  SUPPORTING
}

enum ActorType {
  CLIENT
  ADMIN
  SYSTEM
}

model AdminUser {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         AdminRole  @default(OPERADOR)
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  versions     TemplateVersion[]
}

/// Categoria de infração. Novas categorias são dados, não código.
model InfractionCategory {
  id                  String     @id @default(cuid())
  code                String     @unique
  name                String
  description         String?
  active              Boolean    @default(true)
  /// Prazo indicativo para defesa (dias úteis) — valor a validar juridicamente.
  defenseDeadlineDays Int?
  priceCents          Int        @default(2900)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  templates           Template[]
  cases               Case[]
}

/// Minuta jurídica (metadados). O conteúdo vive em TemplateVersion.
model Template {
  id                String             @id @default(cuid())
  code              String             @unique
  internalName      String
  categoryId        String
  category          InfractionCategory @relation(fields: [categoryId], references: [id])
  applicantType     ApplicantType
  processType       String
  competentEntity   String
  /// Descrição dos fundamentos aplicáveis (informativo, para o admin).
  groundsSummary    String?
  /// Regras de utilização avaliadas pelo motor de seleção.
  conditions        Json               @default("{}")
  priority          Int                @default(0)
  status            TemplateStatus     @default(INACTIVE)
  isTest            Boolean            @default(false)
  requiresReview    Boolean            @default(false)
  legalValidatedBy  String?
  legalValidatedAt  DateTime?
  currentVersionId  String?            @unique
  currentVersion    TemplateVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions          TemplateVersion[]  @relation("TemplateVersions")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([categoryId, applicantType, status])
}

/// Versão imutável de uma minuta (ficheiro DOCX original).
model TemplateVersion {
  id               String                 @id @default(cuid())
  templateId       String
  template         Template               @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentOf        Template?              @relation("CurrentVersion")
  version          Int
  storageKey       String
  originalFilename String
  sha256           String
  /// Marcadores detetados no DOCX (variáveis e secções).
  placeholders     Json                   @default("[]")
  notes            String?
  createdById      String?
  createdBy        AdminUser?             @relation(fields: [createdById], references: [id])
  createdAt        DateTime               @default(now())
  mappings         TemplateFieldMapping[]
  cases            Case[]
  documents        GeneratedDocument[]

  @@unique([templateId, version])
}

model TemplateFieldMapping {
  id                String          @id @default(cuid())
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  placeholder       String
  sourcePath        String
  format            String          @default("text")
  required          Boolean         @default(false)
  defaultValue      String?

  @@unique([templateVersionId, placeholder])
}

/// Processo de contestação.
model Case {
  id                String              @id @default(cuid())
  reference         String              @unique
  status            CaseStatus          @default(FORM_STARTED)
  categoryId        String
  category          InfractionCategory  @relation(fields: [categoryId], references: [id])
  applicantType     ApplicantType
  /// Dados do formulário encriptados (AES-256-GCM).
  dataEnc           String
  /// Campos mínimos em claro para listagem e contacto.
  displayName       String
  email             String
  accessTokenHash   String              @unique
  templateVersionId String?
  templateVersion   TemplateVersion?    @relation(fields: [templateVersionId], references: [id])
  selectionOutcome  SelectionOutcome?
  selectionTrace    Json?
  privacyConsentAt  DateTime?
  termsAcceptedAt   DateTime?
  disclaimersAt     DateTime?
  retentionUntil    DateTime?
  anonymizedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  files             CaseFile[]
  payments          Payment[]
  documents         GeneratedDocument[]

  @@index([status])
  @@index([createdAt])
}

model CaseFile {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind         FileKind
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  sha256       String
  createdAt    DateTime @default(now())
}

model Payment {
  id           String        @id @default(cuid())
  caseId       String
  case         Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  provider     String
  method       PaymentMethod
  amountCents  Int
  currency     String        @default("EUR")
  status       PaymentStatus @default(PENDING)
  /// Identificador do pagamento do nosso lado (orderId enviado ao gateway).
  providerRef  String        @unique
  /// Token do gateway (ex.: RequestId ifthenpay).
  providerRequestId String?  @unique
  /// Dados de pagamento a mostrar ao cliente (entidade/referência MB, telemóvel MB WAY mascarado, URL cartão).
  instructions Json?
  raw          Json?
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
}

model GeneratedDocument {
  id                String          @id @default(cuid())
  caseId            String
  case              Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  docxKey           String
  pdfKey            String
  pdfSha256         String
  createdAt         DateTime        @default(now())
  deliveredAt       DateTime?
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  action     String
  entityType String
  entityId   String
  meta       Json?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
