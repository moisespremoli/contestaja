# Base de dados
DATABASE_URL="postgresql://USER@localhost:5432/contestaja?schema=public"

# URL pública da aplicação (links em emails)
APP_URL="http://localhost:3000"

# Segredos (gerar com: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=""      # 32 bytes base64 — encriptação AES-256-GCM dos dados do processo
SESSION_SECRET=""           # assinatura das sessões admin
DOWNLOAD_SIGNING_SECRET=""  # assinatura dos links temporários
PAYMENT_WEBHOOK_SECRET=""   # assinatura dos webhooks do provider de pagamento

# Admin inicial (seed)
SEED_ADMIN_EMAIL="admin@contestaja.local"
SEED_ADMIN_PASSWORD=""

# Armazenamento privado (fora de /public)
STORAGE_DIR="./storage"

# Conversão PDF: libreoffice | gotenberg
PDF_CONVERTER="libreoffice"
SOFFICE_PATH="soffice"
GOTENBERG_URL=""

# Pagamentos: mock | (futuro) easypay | ifthenpay | eupago
PAYMENT_PROVIDER="mock"

# Email (vazio => grava .eml em storage/outbox)
SMTP_URL=""
EMAIL_FROM="ContestaJá <nao-responder@contestaja.pt>"

# RGPD: dias de conservação após conclusão
RETENTION_DAYS="180"
